# .env.example
# Copy to .env and fill in real values. Real .env is gitignored.

# --- Interactive Brokers ---
IBKR_MODE=native
IBKR_RUNTIME=live
IBKR_HOST=127.0.0.1
IBKR_PORT=4001
IBKR_CLIENT_ID=101
IBKR_READONLY=false
IBKR_BASE_URL=https://localhost:5000/portal.proxy/v1/api
IBKR_ACCOUNT_ID=
IBKR_USERNAME=

# --- Mailgun ---
MAILGUN_DOMAIN=
MAILGUN_SENDER=
MAILGUN_RECIPIENT=
MAILGUN_API_KEY=

# --- OpenClaw approval gate (set during bootstrap) ---
OPENCLAW_APPROVAL_SAFEWORD=
OPENCLAW_APPROVAL_PIN=

# --- Sentry (error tracking) ---
# DSN is the client-side identifier shown when you create a Sentry project.
SENTRY_DSN=
# Auth token: scopes project:read, event:read, issue:read (rotate any time).
SENTRY_AUTH_TOKEN=
# Org + project slugs — find them in the Sentry project URL:
#   https://sentry.io/organizations/<ORG_SLUG>/projects/<PROJECT_SLUG>/
SENTRY_ORG_SLUG=
SENTRY_PROJECT_SLUG=
SENTRY_ENVIRONMENT=production
# Optional release tag for grouping events by deploy.
SENTRY_RELEASE=

# --- Sentry autonomous-fix cron ---
# false = Tier 1 (branch + you merge). true = Tier 2 (auto-merge in allowlisted paths).
SENTRY_AUTOFIX_AUTOMERGE=true
# Comma-separated path prefixes the autofixer is allowed to write to.
# Execution / live-trading paths are denylisted in code regardless of this list.
SENTRY_AUTOFIX_ALLOWLIST=scripts/,lib/observability/,lib/
# Max issues processed per weekly run.
SENTRY_AUTOFIX_MAX_ISSUES=5
